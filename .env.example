# Database (local: docker-compose, prod: Neon — neon.tech)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/formpilot"

# Redis (local: docker-compose, prod: Upstash — upstash.com)
REDIS_URL="redis://localhost:6379"

# Auth
AUTH_SECRET="run: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional — console.cloud.google.com)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Brevo — brevo.com, 300 emails/day free)
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""
BREVO_FROM_NAME="FormPilot"

# App URL (used for endpoint URLs in dashboard)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
